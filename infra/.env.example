# Rendered on the server by scripts/fetch-secrets.sh from SSM Parameter Store (/velkin/core/*).
# Never commit the real file.
COMPOSE_FILE=compose.yml:projects/site.yml:projects/analytics.yml
COMPOSE_PROJECT_NAME=velkin

DOMAIN=velkin.com
ACME_EMAIL=ops@velkin.com
AWS_REGION=us-east-1
HOSTNAME_TAG=prod
REGISTRY=ghcr.io/your-github-org

# Cloudflare API token: Zone.DNS:Edit on velkin.com only (for the wildcard cert DNS challenge)
CF_DNS_API_TOKEN=

# Use hex/alphanumeric passwords (openssl rand -hex 24) — they are embedded in URLs and SQL.
POSTGRES_SUPERUSER_PASSWORD=
SITE_DB_PASSWORD=
SITE_REDIS_PASSWORD=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
PROJECT_DATABASES=velkin_site:velkin_site:${SITE_DB_PASSWORD},umami:umami:${UMAMI_DB_PASSWORD}

SITE_API_TAG=latest
SITE_ADMIN_TAG=latest
