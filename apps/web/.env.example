# Public site URL (no trailing slash)
SITE_URL=https://velkine.com
NEXT_PUBLIC_SITE_URL=https://velkine.com
# Backend (server-side fetches for CMS; leave empty to use the built-in seed content)
API_URL=https://api.velkine.com
NEXT_PUBLIC_API_URL=https://api.velkine.com
# Shared secret the API uses to call /api/revalidate after CMS edits
REVALIDATE_SECRET=change-me
# Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Umami (privacy-friendly analytics). Loaded only after consent.
NEXT_PUBLIC_UMAMI_URL=https://analytics.velkine.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Contact channels
NEXT_PUBLIC_CONTACT_EMAIL=hello@velkine.com
NEXT_PUBLIC_WHATSAPP=   # digits only, international format, e.g. 15551234567
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/velkin
# Company time zone for call slots (IANA)
NEXT_PUBLIC_COMPANY_TZ=America/Bogota
