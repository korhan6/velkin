NODE_ENV=development
PORT=4000
TZ=UTC

# Database / cache
DATABASE_URL=postgresql://velkin_site:change-me@localhost:5432/velkin_site?schema=public
REDIS_URL=redis://:change-me@localhost:6379/0

# CORS / cookies
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://velkin.com,https://www.velkin.com,https://admin.velkin.com
COOKIE_DOMAIN=localhost
ADMIN_URL=http://localhost:3001
SITE_URL=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=generate-64-random-bytes
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
REQUIRE_2FA_FOR_ADMINS=true
SEED_ADMIN_EMAIL=admin@velkin.com
SEED_ADMIN_PASSWORD=change-me-now-please

# Anti-spam (Cloudflare Turnstile secret)
TURNSTILE_SECRET=

# Storage (S3) — private bucket for lead attachments, public bucket/CDN for CMS media
AWS_REGION=us-east-1
S3_LEADS_BUCKET=velkin-leads
S3_MEDIA_BUCKET=velkin-media
MEDIA_PUBLIC_URL=https://media.velkin.com

# Email: resend | ses | log
MAIL_PROVIDER=log
MAIL_FROM="Velkin <hello@velkin.com>"
MAIL_TEAM_TO=sales@velkin.com
RESEND_API_KEY=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_WEBHOOK_URL=

# Web ISR revalidation
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me

SWAGGER_ENABLED=true
